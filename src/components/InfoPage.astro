---
import Layout from '../layouts/Layout.astro';
import PageHeader from './PageHeader.astro';
import SiteFooter from './SiteFooter.astro';

interface Props { title: string; description: string; eyebrow?: string; robots?: string; }
const { title, description, eyebrow = 'Metadata Remover', robots } = Astro.props;
---

<Layout {title} {description} {robots}>
  <PageHeader />
  <main class="page-shell py-14 sm:py-20">
    <article class="mx-auto max-w-3xl">
      <p class="font-mono text-xs font-medium uppercase tracking-[0.14em] text-muted">{eyebrow}</p>
      <h1 class="mt-4 font-display text-4xl font-extrabold tracking-[-0.055em] text-ink sm:text-5xl">{title}</h1>
      <div class="seo-prose mt-10 space-y-8 text-base leading-7 text-body"><slot /></div>
    </article>
  </main>
  <SiteFooter />
  <script src="../scripts/theme.js"></script>
</Layout>
