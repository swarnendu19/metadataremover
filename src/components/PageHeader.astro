---
import { languages, languagePath, type Lang } from '../i18n/home';

interface Props { home?: boolean; lang?: Lang; }
const { home = false, lang = 'en' } = Astro.props;
const homeLabels: Record<Lang, { how: string; privacy: string; formats: string; clean: string; short: string }> = {
  en: { how: 'How it works', privacy: 'Privacy', formats: 'Formats', clean: 'Clean a file', short: 'Clean' },
  es: { how: 'Cómo funciona', privacy: 'Privacidad', formats: 'Formatos', clean: 'Limpiar un archivo', short: 'Limpiar' },
  ja: { how: '使い方', privacy: 'プライバシー', formats: '形式', clean: 'ファイルを整理', short: '整理' },
  fr: { how: 'Fonctionnement', privacy: 'Confidentialité', formats: 'Formats', clean: 'Nettoyer un fichier', short: 'Nettoyer' },
  de: { how: 'So funktioniert es', privacy: 'Datenschutz', formats: 'Formate', clean: 'Datei bereinigen', short: 'Bereinigen' },
  pt: { how: 'Como funciona', privacy: 'Privacidade', formats: 'Formatos', clean: 'Limpar arquivo', short: 'Limpar' },
  ko: { how: '사용 방법', privacy: '개인정보', formats: '형식', clean: '파일 정리', short: '정리' },
  it: { how: 'Come funziona', privacy: 'Privacy', formats: 'Formati', clean: 'Pulisci un file', short: 'Pulisci' },
  id: { how: 'Cara kerja', privacy: 'Privasi', formats: 'Format', clean: 'Bersihkan file', short: 'Bersihkan' },
};
const labels = homeLabels[lang];
const links = home
  ? [{ href: '#how-it-works', label: labels.how }, { href: '#privacy', label: labels.privacy }, { href: '#formats', label: labels.formats }, { href: '/blog/', label: 'Blog' }]
  : [{ href: '/', label: 'Home' }, { href: '/blog/', label: 'Blog' }, { href: '/privacy-policy', label: 'Privacy' }, { href: '/contact-us', label: 'Contact' }];
---

<header class="border-b border-hairline bg-white">
  <nav class="page-shell flex min-h-16 items-center justify-between gap-5" aria-label="Main navigation">
    <a href={languagePath(lang)} aria-label="Metadata Remover" class="header-brand flex items-center gap-2.5 font-display text-[15px] font-extrabold tracking-[-0.04em] no-underline text-ink"><span class="brand-mark grid size-7 shrink-0 place-items-center rounded-lg" aria-hidden="true"><svg viewBox="0 0 24 24" class="size-4 fill-none stroke-current" stroke-width="2.63" stroke-linecap="round" stroke-linejoin="round"><path d="M18 12.5V10a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v1.4" /><path d="M14 11V9a2 2 0 1 0-4 0v2" /><path d="M10 10.5V5a2 2 0 1 0-4 0v9" /><path d="m7 15-1.76-1.76a2 2 0 0 0-2.83 2.82l3.6 3.6C7.5 21.14 9.2 22 12 22h2a8 8 0 0 0 8-8V7a2 2 0 1 0-4 0v5" /></svg></span><span class="brand-name">Metadata Remover</span></a>
    <div class="hidden items-center gap-6 text-sm font-semibold sm:flex">{links.map((link) => <a href={link.href} class="nav-link hover:text-ink">{link.label}</a>)}</div>
    <div class="header-actions flex shrink-0 items-center gap-2">
      <details class="language-picker relative">
        <summary class="grid size-10 cursor-pointer list-none place-items-center rounded-lg border border-hairline bg-white text-sm font-bold uppercase text-ink" aria-label={`${lang.toUpperCase()} — Choose language`}>{lang}</summary>
        <div class="absolute right-0 z-50 mt-2 grid min-w-44 gap-1 rounded-xl border border-hairline bg-white p-2 shadow-xl">
          {Object.entries(languages).map(([code, language]) => <a class:list={['rounded-lg px-3 py-2 text-sm no-underline hover:bg-surface-soft', code === lang ? 'font-extrabold text-ink' : 'font-semibold text-body']} href={languagePath(code as Lang)} lang={language.hreflang} aria-current={code === lang ? 'page' : undefined}>{language.label}</a>)}
        </div>
      </details>
      <button id="theme-toggle" type="button" class="grid size-10 shrink-0 place-items-center rounded-lg border border-hairline bg-white text-sm font-bold text-ink" aria-label="Switch to light theme" title="Switch theme"></button>{home && <a href="#remover" aria-label={labels.clean} class="header-cta shrink-0 rounded-lg bg-ink px-4 py-2.5 text-sm font-bold text-white no-underline"><span class="clean-label-full" aria-hidden="true">{labels.clean}</span><span class="clean-label-short" aria-hidden="true">{labels.short}</span></a>}
    </div>
  </nav>
</header>
