---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	image?: string;
	imageAlt?: string;
	robots?: string;
	structuredData?: Record<string, unknown>;
}

const {
	title = 'Free Metadata Remover for Photos, Images & PDFs',
	description = 'Remove metadata from photos, images, and PDFs free in your browser. Inspect EXIF, GPS, camera, and author data, then clean and verify files locally.',
	canonical: canonicalOverride,
	image = 'https://metadataremovertool.com/metadata-remover-social.png',
	imageAlt = 'Metadata Remover for photos, images, and PDFs with private cleanup and no uploads',
	robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
	structuredData,
} = Astro.props;

const canonical = canonicalOverride ?? new URL(Astro.url.pathname, Astro.site ?? 'https://metadataremovertool.com').href;
---

<!doctype html>
<html lang="en" prefix="og: https://ogp.me/ns#">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="MetadataRemover" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#101010" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="Metadata Remover" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={image} />
		<meta property="og:image:secure_url" content={image} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<meta name="twitter:image:alt" content={imageAlt} />

		{structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
	</head>
	<body data-theme="dark">
		<slot />
	</body>
</html>
