---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import RemoverLoader from '../../components/RemoverLoader.astro';
import { alternates, homeContent, languages, siteUrl, translatedLangs, type Lang } from '../../i18n/home';

export function getStaticPaths() {
  return translatedLangs.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Exclude<Lang, 'en'> };
const content = homeContent[lang];
const locale = languages[lang];
const canonical = `${siteUrl}/${lang}/`;
const socialImage = `${siteUrl}/metadata-remover-social.png`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebApplication', '@id': `${canonical}#application`, name: content.h1, url: canonical, description: content.description, image: socialImage, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', browserRequirements: 'JavaScript and a modern browser', inLanguage: locale.hreflang, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } },
    { '@type': 'FAQPage', '@id': `${canonical}#faq`, inLanguage: locale.hreflang, mainEntity: content.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) },
  ],
};
---

<Layout title={content.title} description={content.description} {canonical} {alternates} lang={locale.hreflang} ogLocale={locale.ogLocale} image={socialImage} imageAlt={content.h1} {structuredData}>
  <PageHeader home {lang} />
  <main>
    <section class="page-shell grid gap-12 py-16 lg:grid-cols-[1fr_1.05fr] lg:items-center lg:py-24">
      <div>
        <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-surface-card px-3 py-1.5 text-xs font-bold text-body"><span class="size-2 rounded-full bg-success"></span>{content.privateLabel}</div>
        <h1 class="max-w-[650px] font-display text-4xl font-extrabold leading-[1.06] tracking-[-0.06em] text-ink sm:text-5xl xl:text-6xl">{content.h1}</h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-body">{content.lead}</p>
        <div class="mt-8 flex flex-wrap gap-x-5 gap-y-3 text-sm font-semibold text-body">{content.benefits.map((benefit) => <span><span class="text-success">✓</span> {benefit}</span>)}</div>
      </div>
      <div id="remover" class="rounded-2xl border border-hairline bg-white p-3 shadow-[0_18px_50px_rgba(17,17,17,0.08)] sm:p-5">
        <div id="upload-panel" class="dotted-surface rounded-xl border border-dashed border-[#bfc5cc] px-5 py-10 text-center sm:px-10 sm:py-14">
          <div class="upload-mark mx-auto grid size-12 place-items-center rounded-xl shadow-lg"><svg viewBox="0 0 24 24" class="size-6 fill-none stroke-current" stroke-width="1.8"><path d="M12 16V4m0 0L7.5 8.5M12 4l4 4.5M5 19h14" /></svg></div>
          <h2 class="mt-5 font-display text-2xl font-extrabold tracking-[-0.04em]">{content.uploadTitle}</h2>
          <p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-muted">{content.uploadText}</p>
          <input id="file-input" class="sr-only" type="file" aria-label={content.choose} accept="image/jpeg,image/png,image/webp,application/pdf" multiple />
          <button id="choose-files" type="button" class="mt-6 rounded-lg bg-ink px-5 py-3 text-sm font-bold text-white">{content.choose}</button>
          <p class="mt-5 font-mono text-xs text-muted">JPG · PNG · WebP · PDF</p>
        </div>
        <div class="mt-4 flex items-start gap-3 rounded-xl bg-surface-card p-4 text-left"><svg viewBox="0 0 24 24" class="mt-0.5 size-5 shrink-0 fill-none stroke-success" stroke-width="2"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg><p class="text-sm leading-6 text-body"><strong class="text-ink">{content.localTitle}</strong> {content.localText}</p></div>
        <div id="analysis-results" class="mt-5 hidden" aria-live="polite"></div>
      </div>
    </section>
    <section id="how-it-works" class="border-y border-hairline bg-surface-soft py-16 sm:py-24"><div class="page-shell"><p class="font-mono text-xs font-medium uppercase tracking-[0.14em] text-muted">{content.howKicker}</p><h2 class="mt-4 max-w-3xl font-display text-3xl font-extrabold tracking-[-0.05em] sm:text-4xl">{content.howTitle}</h2><div class="mt-10 grid gap-4 md:grid-cols-4">{content.steps.map((step, index) => <article class="rounded-xl bg-white p-6"><span class="font-mono text-xs text-muted">0{index + 1}</span><h3 class="mt-8 font-display text-xl font-extrabold tracking-[-0.035em]">{step.title}</h3><p class="mt-2 text-sm leading-6 text-body">{step.text}</p></article>)}</div></div></section>
    <section id="privacy" class="page-shell grid gap-10 py-16 sm:py-24 lg:grid-cols-[0.75fr_1.25fr]"><div><p class="font-mono text-xs font-medium uppercase tracking-[0.14em] text-muted">{content.aboutKicker}</p><h2 class="mt-4 font-display text-3xl font-extrabold tracking-[-0.05em] sm:text-4xl">{content.aboutTitle}</h2></div><div class="seo-prose space-y-5 text-base leading-8 text-body">{content.about.map((paragraph) => <p>{paragraph}</p>)}</div></section>
    <section id="formats" class="border-y border-hairline bg-surface-soft py-16 sm:py-24"><div class="page-shell"><h2 class="max-w-3xl font-display text-3xl font-extrabold tracking-[-0.05em] sm:text-4xl">{content.guideTitle}</h2><ol class="mt-10 grid gap-4 md:grid-cols-3">{content.guide.map((step, index) => <li class="rounded-xl bg-white p-6"><span class="font-mono text-xs text-muted">0{index + 1}</span><h3 class="mt-6 font-display text-xl font-extrabold">{step.title}</h3><p class="mt-3 text-sm leading-7 text-body">{step.text}</p></li>)}</ol></div></section>
    <section id="faq" class="page-shell grid gap-10 py-16 sm:py-24 lg:grid-cols-[0.72fr_1.28fr]"><div><h2 class="font-display text-3xl font-extrabold tracking-[-0.05em] sm:text-4xl">{content.faqTitle}</h2><p class="mt-5 max-w-sm leading-7 text-body">{content.faqIntro}</p></div><div class="faq-list space-y-3">{content.faqs.map((faq, index) => <details class="rounded-xl border border-hairline bg-white" open={index === 0}><summary class="flex min-h-14 cursor-pointer items-center gap-4 px-5 py-4 font-display text-base font-extrabold text-ink">{faq.question}</summary><div class="border-t border-hairline px-5 py-4 text-sm leading-7 text-body">{faq.answer}</div></details>)}</div></section>
  </main>
  <SiteFooter />
  <RemoverLoader />
</Layout>
