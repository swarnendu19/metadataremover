---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const canonical = 'https://metadataremovertool.com/blog/';
const title = 'Photo Metadata Privacy Guides | Metadata Remover';
const description = 'Practical, evidence-led guides for checking photo metadata, removing GPS coordinates, and sharing images more safely.';
const articleUrl = `${canonical}can-facebook-marketplace-photos-reveal-your-home-address/`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#page`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'en',
      isPartOf: { '@type': 'WebSite', '@id': 'https://metadataremovertool.com/#website', name: 'Metadata Remover', url: 'https://metadataremovertool.com/' },
    },
    {
      '@type': 'ItemList',
      itemListElement: [{ '@type': 'ListItem', position: 1, url: articleUrl, name: 'Can Facebook Marketplace Photos Reveal Your Home Address?' }],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://metadataremovertool.com/' },
        { '@type': 'ListItem', position: 2, name: 'Privacy guides', item: canonical },
      ],
    },
  ],
};
---

<Layout {title} {description} {canonical} {structuredData}>
  <PageHeader />
  <main>
    <section class="border-b border-hairline bg-surface-soft py-16 sm:py-24">
      <div class="page-shell max-w-4xl">
        <p class="font-mono text-xs font-medium uppercase tracking-[0.14em] text-muted">Privacy guides</p>
        <h1 class="mt-4 font-display text-4xl font-extrabold tracking-[-0.055em] text-ink sm:text-6xl">Know what a file reveals before you share it.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-body">Practical answers about GPS, EXIF, visible clues, and safer sharing—based on what a file actually contains, not vague privacy promises.</p>
      </div>
    </section>
    <section class="page-shell py-12 sm:py-20" aria-labelledby="latest-guide">
      <article class="grid overflow-hidden rounded-2xl border border-hairline bg-white lg:grid-cols-[0.72fr_1.28fr]">
        <div class="grid min-h-64 place-items-center bg-ink p-8 text-white">
          <div class="max-w-xs">
            <p class="font-mono text-xs uppercase tracking-[0.15em] text-[#a1a1aa]">Facebook Marketplace</p>
            <p class="mt-5 font-display text-3xl font-extrabold leading-tight tracking-[-0.05em]">A photo can disclose a place in more than one way.</p>
          </div>
        </div>
        <div class="p-7 sm:p-10">
          <p class="font-mono text-xs uppercase tracking-[0.14em] text-muted"><time datetime="2026-09-20">September 20, 2026</time> · 9 min read</p>
          <h2 id="latest-guide" class="mt-4 font-display text-3xl font-extrabold tracking-[-0.045em] text-ink">Can Facebook Marketplace Photos Reveal Your Home Address?</h2>
          <p class="mt-5 leading-7 text-body">Learn how to find GPS coordinates on iPhone, Android, and Windows, distinguish metadata from visible location clues, and check the exact photo you plan to post.</p>
          <a href="/blog/can-facebook-marketplace-photos-reveal-your-home-address/" class="mt-7 inline-flex rounded-lg bg-ink px-5 py-3 text-sm font-extrabold text-white no-underline">Read the complete privacy check</a>
        </div>
      </article>
    </section>
  </main>
  <SiteFooter />
</Layout>
